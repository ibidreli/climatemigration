        </mxCell>
        <mxCell id="mig" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontStyle=0;align=left;verticalAlign=middle;spacing=18;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="Abwandernde Personen&#xa;&#xa;Betroffenheit: verlassen die Region im Kontext unsicherer Lebensgrundlagen.&#xa;Systemwirkung: verändern lokale Bevölkerung und verfügbare Arbeitskräfte.&#xa;Beziehungen: bleiben potenziell über Familie, Netzwerke und Rücküberweisungen verbunden." vertex="1">
          <mxGeometry height="290" width="760" x="50" y="930" as="geometry" />
