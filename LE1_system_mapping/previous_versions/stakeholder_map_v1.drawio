        <mxCell id="house" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontStyle=0;align=left;verticalAlign=middle;spacing=18;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="Lokale Haushalte&#xa;&#xa;Betroffenheit: Dürre, Wasserknappheit, Ernteausfälle und Abwanderung.&#xa;Interessen: verlässliche Versorgung, tragfähiges Einkommen und gesicherte Lebensgrundlagen.&#xa;Rolle: treffen bzw. tragen Entscheidungen über Erwerb und Abwanderung." vertex="1">
