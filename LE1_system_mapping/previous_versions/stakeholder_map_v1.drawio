        <mxCell id="farm" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontStyle=0;align=left;verticalAlign=middle;spacing=18;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="Landwirtschaftliche Betriebe und Bauern&#xa;&#xa;Betroffenheit: abhängig von Wasserverfügbarkeit und landwirtschaftlichen Erträgen.&#xa;Interessen: stabile Produktion, verfügbare Arbeitskräfte und ausreichendes Einkommen.&#xa;Ansatzpunkte: Anbau, Bewässerung und landwirtschaftliche Anpassung." vertex="1">
